<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AnxiouslyOptimized - Easy PC Speed &amp; Game Booster" 
        Height="780" Width="1240" 
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#000000" Foreground="#FFFFFF"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, Aptos, system-ui, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- Native Windows Resizing and Aero Snap Integration -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

            <Window.Resources>
        <!-- High-Performance Solid OLED Black Theme Tokens (Zero Gradients, Pure OLED Deep Black) -->
        <SolidColorBrush x:Key="OverviewCardBg" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="OverviewCardBorder" Color="#1C1C22"/>
        <SolidColorBrush x:Key="OverviewCardHoverBg" Color="#121216"/>
        <SolidColorBrush x:Key="OverviewCardHoverBorder" Color="#2A2A35"/>

        <SolidColorBrush x:Key="CardActionBtnBg" Color="#14141A"/>
        <SolidColorBrush x:Key="CardActionBtnBorder" Color="#262632"/>
        <SolidColorBrush x:Key="CardActionBtnHoverBg" Color="#1C1C24"/>
        <SolidColorBrush x:Key="CardActionBtnHoverBorder" Color="#00F5D4"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A"/>
        <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#14141A"/>
        <SolidColorBrush x:Key="SidebarActiveFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarCardBgBrush" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="SidebarCardBorderBrush" Color="#1C1C22"/>
        <SolidColorBrush x:Key="CircleNavBgBrush" Color="#14141A"/>
        <SolidColorBrush x:Key="CircleNavBorderBrush" Color="#262632"/>
        <SolidColorBrush x:Key="SidebarHoverBgBrush" Color="#0E0E12"/>

        <!-- Universal Dynamic Section Banners &amp; Status Badges -->
        <SolidColorBrush x:Key="SectionBannerBg" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="SectionBannerBorder" Color="#1C1C22"/>
        <SolidColorBrush x:Key="SectionBannerTitleBrush" Color="#00F5D4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00F5D4"/>

        <SolidColorBrush x:Key="TweakCardBg" Color="#09090C"/>
        <SolidColorBrush x:Key="TweakCardBorder" Color="#18181E"/>
        <SolidColorBrush x:Key="TweakCardHoverBg" Color="#111116"/>

        <SolidColorBrush x:Key="BadgeOptimizedBg" Color="#061A14"/>
        <SolidColorBrush x:Key="BadgeOptimizedBorder" Color="#0F5132"/>
        <SolidColorBrush x:Key="BadgeOptimizedFg" Color="#10B981"/>

        <SolidColorBrush x:Key="BadgeStandardBg" Color="#121216"/>
        <SolidColorBrush x:Key="BadgeStandardBorder" Color="#22222A"/>
        <SolidColorBrush x:Key="BadgeStandardFg" Color="#71717A"/>

        <SolidColorBrush x:Key="WarningBannerBg" Color="#140C06"/>
        <SolidColorBrush x:Key="WarningBannerBorder" Color="#3D2109"/>

        <SolidColorBrush x:Key="DangerBannerBg" Color="#140809"/>
        <SolidColorBrush x:Key="DangerBannerBorder" Color="#3E1417"/>

        <SolidColorBrush x:Key="SuccessBannerBg" Color="#061710"/>
        <SolidColorBrush x:Key="SuccessBannerBorder" Color="#0D422B"/>

        <SolidColorBrush x:Key="InputSearchBg" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="InputSearchBorder" Color="#1C1C22"/>
        <SolidColorBrush x:Key="InputSearchFg" Color="#FFFFFF"/>

        <!-- Swift Tab Content Transition Animation -->
        <Storyboard x:Key="TabEntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.18" DecelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- World-Class Solid OLED Bento Card Style -->
        <Style x:Key="OverviewCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OverviewCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OverviewCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="MinHeight" Value="216"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OverviewCardHoverBorder}"/>
                    <Setter Property="Background" Value="{DynamicResource OverviewCardHoverBg}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="-2" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" To="18" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.65" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius" To="12" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.45" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- General Solid OLED Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OverviewCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OverviewCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Min / Max) -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BrdCtrl" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrdCtrl" Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BrdCtrl" Property="Background" Value="#27272A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button -->
        <Style x:Key="WinCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BrdCtrl" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrdCtrl" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BrdCtrl" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Mint Cyan (Scan My PC CTA) -->
        <Style x:Key="ButtonScanCTA" TargetType="Button">
            <Setter Property="Background" Value="#00F5D4"/>
            <Setter Property="BorderBrush" Value="#5EEAD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BrdBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrdBtn" Property="Background" Value="#2DD4BF"/>
                                <Setter TargetName="BrdBtn" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BrdBtn" Property="Background" Value="#0D9488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overview Card Bottom Action Button -->
        <Style x:Key="ButtonCardAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardActionBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardActionBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BrdBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrdBtn" Property="Background" Value="{DynamicResource CardActionBtnHoverBg}"/>
                                <Setter TargetName="BrdBtn" Property="BorderBrush" Value="{DynamicResource CardActionBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BrdBtn" Property="Background" Value="#0A0A0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Action Navigation Button (Solid Disc) -->
        <Style x:Key="ButtonCircleNav" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CircleNavBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircleNavBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BrdCircle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrdCircle" Property="Background" Value="#1C1C24"/>
                                <Setter TargetName="BrdCircle" Property="BorderBrush" Value="#00F5D4"/>
                                <Setter Property="Foreground" Value="#00F5D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BrdCircle" Property="Background" Value="#0E0E12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid Action Profile Buttons (Primary, Blue, Purple, Flame, Danger, Secondary) -->
