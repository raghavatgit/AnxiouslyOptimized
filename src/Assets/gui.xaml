                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Force Dedicated High-Speed GPU" FontSize="13" FontWeight="Bold" Foreground="#3B82F6"/>
                                                            <TextBlock Text="Forces Windows and emulator settings to run exclusively on dedicated NVIDIA/AMD graphics." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnFFGpuLock" Grid.Row="1" Content="Lock to Dedicated GPU" Style="{StaticResource ButtonSecondary}" Margin="0,10,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Drag Headshot Mouse Smoothness -->
                                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OverviewCard}" Margin="0,0,10,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Smooth Mouse Aim for Drag Headshots" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                                                            <TextBlock Text="Disables mouse acceleration and smooths vertical drag curve for predictable upward headshots." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnFFMouseAim" Grid.Row="1" Content="Apply Smooth Aim" Style="{StaticResource ButtonSecondary}" Margin="0,10,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Low Ping Network -->
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Low Ping Network (Fix Delayed Hits)" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                            <TextBlock Text="Disables multimedia throttling and optimizes system responsiveness for gaming packets without download bottlenecks." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnFFLowPing" Grid.Row="1" Content="Apply Low Ping" Style="{StaticResource ButtonSecondary}" Margin="0,10,0,0"/>
                                                    </Grid>
                                                </Border>


                                                <!-- VBS / Security Toggle -->
                                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource OverviewCard}" Margin="0,0,10,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Emulator Speed Boost (Toggle VBS)" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                                                            <TextBlock Text="Allows emulators to run with direct hardware virtualization instead of slowed nested layers." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnToggleVBS" Grid.Row="1" Content="Toggle VBS Mode" Style="{StaticResource ButtonSecondary}" Margin="0,10,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Clean Cache -->
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="Clean Emulator Logs &amp; Shader Caches" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="Removes old logs and shader caches to fix emulator loading getting stuck at 99%." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnFFCleanCache" Grid.Row="1" Content="Clean Emulator Cache" Style="{StaticResource ButtonSecondary}" Margin="0,10,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Reset Settings -->
                                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OverviewCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Reset All Game &amp; Emulator Settings" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="Restores mouse acceleration, display resolutions, and network registry to original Windows defaults." FontSize="11" Foreground="#8A99AD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Name="BtnFFRevert" Grid.Column="1" Content="Reset Game Settings" Style="{StaticResource ButtonDanger}" MinWidth="180" Height="36" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- ============================================== -->
                            <!-- TAB 6: SETTINGS                                -->
                            <!-- ============================================== -->
                            <TabItem Header="Settings">
                                <Grid>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource TabEntranceAnim}"/>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </Grid.RenderTransform>
                                    <StackPanel Margin="0,4,0,10">
                                        <!-- Application Settings Header (Translucent Frosted Glass) -->
                                        <Border CornerRadius="12" Padding="14,10" BorderThickness="1" Margin="0,0,0,14" Background="{DynamicResource SectionBannerBg}" BorderBrush="{DynamicResource SectionBannerBorder}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="APPLICATION SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionBannerTitleBrush}"/>
                                                <TextBlock Text="Configure behavior, operating system compliance modes, and safety preferences." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Setting: Target OS -->
                                        <Border Style="{StaticResource OverviewCard}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Target Operating System Detection" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Automatically detect Windows version or force Windows 11 / Windows 10 rules." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton Name="RdoOSAuto" Content="Auto-Detect" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,10,0"/>
                                                    <RadioButton Name="RdoOSWin11" Content="Windows 11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                                    <RadioButton Name="RdoOSWin10" Content="Windows 10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Setting: Safety Backups -->
                                        <Border Style="{StaticResource OverviewCard}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Automatic System Restore Point Creation" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Always create a restore point before running any speed profile or repair." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox Name="ChkAutoRestorePoint" Content="Enabled (Recommended)" Foreground="{DynamicResource AccentBrush}" IsChecked="True" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Reset Preferences -->
                                        <Border Style="{StaticResource OverviewCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Reset Application Preferences" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Reset all UI selections, cached statuses, and logs." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Name="BtnResetSettings" Content="Reset Preferences" Style="{StaticResource ButtonSecondary}" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- ============================================== -->
                            <!-- TAB 7: BACKUPS & SYSTEM RESTORE                -->
                            <!-- ============================================== -->
                            <TabItem Header="Backups">
                                <Grid Margin="0,4,0,0">
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource TabEntranceAnim}"/>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                      <!-- Backups Header (Translucent Frosted Glass) -->
                                      <Border Grid.Row="0" CornerRadius="12" Padding="14,10" BorderThickness="1" Margin="0,0,0,10" Background="{DynamicResource SectionBannerBg}" BorderBrush="{DynamicResource SectionBannerBorder}">
                                          <Border.Effect>
                                              <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
                                          </Border.Effect>
                                          <Grid>
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="*"/>
                                                  <ColumnDefinition Width="Auto"/>
                                              </Grid.ColumnDefinitions>
                                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                  <TextBlock Text="SYSTEM RESTORE &amp; REGISTRY BACKUPS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionBannerTitleBrush}"/>
                                                  <TextBlock Text="Windows restore points and backup archives recorded before changes were made." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                              </StackPanel>
                                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                  <Button Name="BtnRefreshBackups" Content="Refresh" Margin="0,0,8,0" Style="{StaticResource ButtonSecondary}"/>
                                                  <Button Name="BtnOpenBackupsFolder" Content="Open Folder" Margin="0,0,8,0" Style="{StaticResource ButtonSecondary}"/>
                                                  <Button Name="BtnLaunchSystemRestore" Content="Windows Restore Wizard" Margin="0,0,8,0" Style="{StaticResource ButtonSecondary}"/>
                                                  <Button Name="BtnCreateRestorePoint" Content="Create Backup Point" Style="{StaticResource ButtonPrimary}"/>
                                              </StackPanel>
                                          </Grid>
                                      </Border>

                                      <!-- Backups List -->
                                      <Border Grid.Row="1" Style="{StaticResource OverviewCard}" Padding="14">
                                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                                              <StackPanel>
                                                  <Grid Margin="0,0,0,10">
                                                      <TextBlock Text="System Restore Points &amp; Registry Snapshots" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                      <TextBlock Name="TxtBackupsCount" Text="Loading backup points..." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                  </Grid>
                                                  <StackPanel Name="PnlRestorePointsList"/>
                                              </StackPanel>
                                          </ScrollViewer>
                                      </Border>

                                     <!-- Revert All Button (Translucent Ruby Glass) -->
                                     <Border Grid.Row="2" CornerRadius="10" Padding="12,10" BorderThickness="1" Margin="0,10,0,0" Background="{DynamicResource DangerBannerBg}" BorderBrush="{DynamicResource DangerBannerBorder}">
                                         <Border.Effect>
                                             <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35"/>
                                         </Border.Effect>
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="Auto"/>
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                 <TextBlock Text="Emergency Factory Reset" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                                                 <TextBlock Text="Revert every tweak, registry entry, and configuration back to original Windows defaults." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                             </StackPanel>
                                             <Button Name="BtnUndoAllRestore" Grid.Column="1" Content="Undo Everything" Style="{StaticResource ButtonDanger}"/>
                                         </Grid>
                                     </Border>
                                </Grid>
                            </TabItem>

                            <!-- ============================================== -->
                            <!-- TAB 8: ABOUT                                   -->
                            <!-- ============================================== -->
                            <TabItem Header="About">
                                <Grid>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource TabEntranceAnim}"/>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </Grid.RenderTransform>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,4,0,10">
                                            <Border Style="{StaticResource OverviewCard}" Padding="20">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <!-- Official Microchip Arrow Brand Logo -->
                                                    <Image Name="ImgAboutLogo" Source="Assets/app_icon.png" Width="72" Height="72" Margin="0,0,0,14" HorizontalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                                                        <Image.Effect>
                                                            <DropShadowEffect BlurRadius="16" Color="#00F5D4" Opacity="0.4" ShadowDepth="0"/>
                                                        </Image.Effect>
                                                    </Image>

                                                    <TextBlock Text="ANXIOUSLY OPTIMIZED" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Consumer Edition v2.5.0 &#x2022; Build 2026" FontSize="11" Foreground="#00F5D4" HorizontalAlignment="Center" Margin="0,3,0,10"/>
                                                    
                                                    <TextBlock Text="AnxiouslyOptimized is a safe, simple, and transparent Windows optimization utility engineered for everyday users, PC gamers, and mobile emulator players." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" LineHeight="17" Margin="0,0,0,16"/>

                                                    <!-- Specifications Card (Translucent Frosted Glass) -->
                                                    <Border CornerRadius="10" BorderThickness="1" Padding="16,12" Width="480" Background="{DynamicResource SectionBannerBg}" BorderBrush="{DynamicResource SectionBannerBorder}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15"/>
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <TextBlock Text="HARDWARE AUDIT SUMMARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SectionBannerTitleBrush}" Margin="0,0,0,8"/>
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Processor (CPU):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Name="TxtHardwareCPU" Text="Detecting..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Installed RAM:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Name="TxtHardwareRAM" Text="Detecting..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Graphics Card (GPU):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Name="TxtHardwareGPU" Text="Detecting..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Storage (SSD):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Name="TxtHardwareStorage" Text="Detecting..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Grid>
                                                                <TextBlock Text="Operating System:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Name="TxtHardwareOS" Text="Detecting..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Expandable Console Drawer (Global Activity Log) -->
                        <Border Name="BrdConsoleDrawer" VerticalAlignment="Bottom" CornerRadius="16" BorderThickness="1" Margin="0,10,0,0" Padding="14" Visibility="Collapsed" Background="#050507" BorderBrush="#1C1C24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="180"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#00F5A0" Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="8" Color="#00F5A0" Opacity="0.9" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="SYSTEM ACTIVITY &amp; EXECUTION LOGS" FontSize="12.5" FontWeight="Bold" Foreground="#00F5D4" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <TextBlock Name="TxtStatusBar" Text="Ready - All systems optimized and healthy" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Name="BtnToggleLogs" Content="Activity Log" Visibility="Collapsed"/>
                                        <Button Name="BtnClearLogs" Content="Clear Logs" Style="{StaticResource ButtonSecondary}" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <Button Name="BtnCopyLogs" Content="Copy" Style="{StaticResource ButtonSecondary}" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <Button Name="BtnCloseDrawer" Content="&#x2715; Close" Style="{StaticResource ButtonSecondary}" Padding="10,4" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" CornerRadius="8" Background="#020204" BorderBrush="#141418" BorderThickness="1" Padding="10,8">
                                    <TextBox Name="TxtConsoleLogs" Background="Transparent" Foreground="#00F5A0" BorderThickness="0" FontFamily="Cascadia Code, Consolas, JetBrains Mono, monospace" FontSize="12.5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" CaretBrush="#00F5D4"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

